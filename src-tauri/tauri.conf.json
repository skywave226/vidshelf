{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "本地视频管理",
  "version": "0.1.0",
  "identifier": "com.tianlang.video-manager",
  "build": {
    "beforeDevCommand": {
      "script": "dx serve --platform web --port 8080 --open false",
      "cwd": "../crates/ui",
      "wait": false
    },
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": {
      "script": "dx build --platform web --release",
      "cwd": "../crates/ui"
    },
    "frontendDist": "../crates/ui/target/dx/video-manager-ui/release/web/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "本地视频管理",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}